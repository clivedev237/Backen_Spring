# Copier en .env pour le développement local (non versionné)

PORT=8080

# Base PostgreSQL UNIQUE et PARTAGÉE (Render) avec Django (Geo) et Node (Auth & Payment).
# Un seul schéma "public", pas de schéma dédié par service (voir VORA_Shared_Database_Guide.md).
# En local sans instance partagée, utiliser un Postgres local (voir README).
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-dae8ef740ujc73e88etg-a.frankfurt-postgres.render.com:5432/voora_db?sslmode=require
SPRING_DATASOURCE_USERNAME=voora_db_user
# NE JAMAIS committer le vrai mot de passe ici : le récupérer depuis les secrets d'équipe / Render.
SPRING_DATASOURCE_PASSWORD=changeme

# URLs des autres microservices VORA
VORA_GEO_BASE_URL=http://localhost:8081
VORA_AUTH_PAYMENT_BASE_URL=http://localhost:8082

# NB : pas de JWT_SECRET ici — la validation JWT est déléguée au Gateway (confirmé).
# En local sans Gateway, positionner manuellement les headers X-User-Id / X-User-Role / X-Driver-Id
# sur les requêtes de test (voir GatewayHeaderAuthenticationFilter).
